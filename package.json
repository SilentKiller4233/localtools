{
  "name": "localtools",
  "version": "0.0.0",
  "private": true,
  "description": "LocalTools — self-hosted, open-source, privacy-first quality-of-life toolkit (PDF / Media / Image / Text & Dev suites)",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "adm-zip": "^0.6.1",
      "fast-uri@<3.1.8": "3.1.8",
      "fast-uri@>=4.0.0 <4.1.5": "4.1.5",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=5.0.0 <5.0.12": "5.0.12"
    }
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test --force && pnpm build && node tools/licensing-check.mjs && pnpm --filter @localtools/client check:worker-offload && pnpm --filter @localtools/client check:offline"
  },
  "devDependencies": {
    "@localtools/eslint-config": "workspace:*",
    "@localtools/prettier-config": "workspace:*",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "^5.6.3"
  }
}
