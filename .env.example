# LocalTools environment configuration.
# Copy to .env and adjust. Every var referenced by Section 5 of PROJECT_SPEC
# appears here with its safe default.

# ── Engine (Layer 2) ────────────────────────────────────────────────────────
# Engine bind address/port inside the container or desktop sidecar.
LOCALTOOLS_ENGINE_HOST=127.0.0.1
LOCALTOOLS_ENGINE_PORT=8787

# Expose the engine beyond localhost? Leave false for normal use.
# If true, LOCALTOOLS_AUTH_TOKEN below MUST be set to >= 32 chars or the
# engine refuses to boot (PROJECT_SPEC Section 5.1).
LOCALTOOLS_EXPOSE=false

# Bearer token required on every request when exposed. Generate one with:
#   openssl rand -hex 32
LOCALTOOLS_AUTH_TOKEN=

# Exact browser origin allowed to call the engine (never a wildcard).
LOCALTOOLS_CLIENT_ORIGIN=http://localhost:5173

# ── Upload / processing limits (Section 5.2 defaults) ──────────────────────
# Per-file cap in bytes (500MB per Section 8).
LOCALTOOLS_MAX_FILE_SIZE=524288000
# Total bytes accepted per request.
LOCALTOOLS_MAX_REQUEST_SIZE=1073741824
# Per-request file-processing timeout in seconds.
LOCALTOOLS_FILE_TIMEOUT_SECONDS=60
# Max simultaneous native-tool subprocesses; requests beyond this get 429.
LOCALTOOLS_MAX_CONCURRENT_SUBPROCESSES=2

# ── Native tool overrides (Section 5.3) ────────────────────────────────────
# Absolute paths to specific executables, for hosts where the tools live
# outside the default install locations. All optional.
LOCALTOOLS_GS_PATH=
LOCALTOOLS_SOFFICE_PATH=
LOCALTOOLS_TESSERACT_PATH=
LOCALTOOLS_TESSDATA_PATH=
LOCALTOOLS_OCRMYPDF_PATH=
LOCALTOOLS_WEASYPRINT_PATH=
LOCALTOOLS_PYTHON_PATH=

# HTML→PDF: opt in to the Playwright+Chromium renderer for JS-heavy pages
# (requires `playwright` + `npx playwright install chromium`).
LOCALTOOLS_PLAYWRIGHT_ENABLED=false

# ── Downloader limits (Section 5.8) ────────────────────────────────────────
# Wall-clock cap for a whole download operation (generous by design).
LOCALTOOLS_DOWNLOAD_TIMEOUT_SECONDS=600
# Hard output size cap in bytes (4GB practical cap per Section 8).
LOCALTOOLS_MAX_DOWNLOAD_SIZE=4294967296
