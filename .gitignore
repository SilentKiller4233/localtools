# Dependencies
node_modules/

# Build outputs
dist/
build/
out/
*.tsbuildinfo

# Turborepo
.turbo/

# Test coverage
coverage/
.nyc_output/

# Environment — never commit real secrets (.env.example is tracked, .env is not)
.env
.env.*
!.env.example

# Editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Vite / dev caches
.vite/

# Rust / Tauri build artifacts (Phase 10)
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/
# The bundled engine copy (built by apps/desktop/scripts/build-engine-dist.mjs,
# never committed — 119MB with node_modules)
apps/desktop/src-tauri/engine-dist/

# Native tool caches used at runtime (never part of the repo)
.cache/

# Session scratch (Phase 8 yt-dlp experiments) — never commit
.tmp-experiment/
downloader-test-*.log

# Portable / locally-installed native toolchain (dev-machine only; the
# Docker image installs these via apt inside the image — Section 11)
gs10.*/
GTK3-Runtime*/
ffmpeg-n*/
ffmpeg-*/
yt-dlp-*/
piper-*/
.handoff-draft.md
